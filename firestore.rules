rules_version = '2';
// RASA Firestore Rules
// posts: curhatan anonim | replies: sub-koleksi posts/{postId}/replies
// users: profil anonim | reports: laporan konten toxic
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // User cuma bisa baca/tulis profilnya sendiri
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Postingan: semua yang login bisa baca, buat post milik sendiri
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      // user boleh update hug/meToo count + aiReply, tapi tidak ganti text orang
      allow update: if signedIn()
        && request.resource.data.text == resource.data.text
        && request.resource.data.authorId == resource.data.authorId;
      // hapus hanya milik sendiri (atau via Admin SDK / panel admin)
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if signedIn();
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Laporan: user bisa bikin, hanya admin (custom claim) yang baca/hapus
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn()
        && request.auth.token.admin == true;
    }
  }
}
